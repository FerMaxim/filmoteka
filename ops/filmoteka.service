[Unit]
Description=Filmoteka Gunicorn
After=network.target postgresql@17-main.service
Requires=postgresql@17-main.service
ConditionPathExists=/srv/filmoteka/current/.release-approved

[Service]
Type=simple
User=filmoteka
Group=filmoteka
WorkingDirectory=/srv/filmoteka/current
EnvironmentFile=/etc/filmoteka/app.env
ExecStart=/usr/local/libexec/filmoteka-start
Restart=on-failure
RestartSec=5
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/filmoteka/shared/media
MemoryMax=384M
TasksMax=64
StandardOutput=journal
StandardError=journal
LogRateLimitIntervalSec=30s
LogRateLimitBurst=100

[Install]
WantedBy=multi-user.target
